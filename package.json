{
  "name": "@0x80/test-ledger",
  "version": "0.1.0",
  "private": false,
  "description": "Telemetry for local test runs: per-test records, host context, and reports.",
  "license": "MIT",
  "author": "Thijs Koerselman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0x80/test-ledger.git"
  },
  "bin": {
    "test-ledger": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./reporter": {
      "types": "./dist/reporter.d.mts",
      "default": "./dist/reporter.mjs"
    },
    "./collector": {
      "types": "./dist/collector.d.mts",
      "default": "./dist/collector.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint -c .oxlintrc.json --import-plugin --type-aware",
    "test": "vitest run",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@tursodatabase/database": "^0.3.0",
    "meow": "^13.2.0"
  },
  "devDependencies": {
    "@codecompose/typescript-config": "^3.2.0",
    "@types/node": "^25.6.2",
    "@typescript/native-preview": "7.0.0-dev.20260519.1",
    "lefthook": "^2.1.8",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "oxlint-tsgolint": "^0.23.0",
    "tsdown": "^0.16.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.1.2"
}
